#!/usr/bin/env bash
set -euo pipefail

# Renders the gateway's nginx.conf into data/ on every start (fresh install,
# restart, AND update) instead of baking it into the gateway image. This
# package uses the stock nginx:alpine image for the gateway, so the routing
# table below is the only thing that makes it Heartwood-specific.
#
# Idempotent: safe to run on every start. Upstream hostnames are the
# Umbrel-injected container names (<app-id>_<service>_1), not bare compose
# service names — the shared umbrel_main_network can have multiple apps
# using generic service names like "web" or "api", so bare service-name DNS
# is not reliable across apps.

APP_DIR="${APP_DATA_DIR:-$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")}"
DATA_DIR="${APP_DIR}/data"
NGINX_DIR="${DATA_DIR}/nginx"

mkdir -p "${NGINX_DIR}"

cat > "${NGINX_DIR}/nginx.conf" <<'EOF'
worker_processes auto;

events {
	worker_connections 1024;
}

http {
	# Preserve the original client/host info for upstreams and SvelteKit.
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;

	# Large-ish PSBT / package payloads shouldn't be truncated.
	client_max_body_size 8m;

	# Docker's embedded DNS server. 127.0.0.11 is only reachable inside the
	# Umbrel Docker network, which is the only place this nginx ever serves
	# traffic. `valid=30s` re-resolves periodically so a restarted upstream
	# that comes back on a new IP is picked up; `ipv6=off` avoids pointless
	# AAAA lookups.
	resolver 127.0.0.11 valid=30s ipv6=off;

	server {
		listen 80;
		server_name _;

		# --- Block explorer UI (mempool frontend) ------------------------------
		# Known limitation: the stock mempool frontend build has its base href
		# baked to "/", so absolute-root asset URLs it emits (e.g. /main.js)
		# resolve against the gateway root, not /explorer/ — this can break
		# asset loading under this prefix. Tracked as a follow-up; the wallet
		# (the catch-all route below) is unaffected.
		location /explorer/ {
			set $upstream_web heartwood-v2_mempool-web_1:8080;
			proxy_pass http://$upstream_web$request_uri;
		}

		# --- mempool backend websocket (must come before the plain /api/ block) -
		location /api/v1/ws {
			set $upstream_api heartwood-v2_mempool-api_1:8999;
			proxy_pass http://$upstream_api$request_uri;
			proxy_http_version 1.1;
			proxy_set_header Upgrade $http_upgrade;
			proxy_set_header Connection "upgrade";
			proxy_read_timeout 3600s;
			proxy_send_timeout 3600s;
		}

		# --- mempool backend REST (Esplora-compatible) -------------------------
		# The backend serves everything under /api/v1/ (its API_URL_PREFIX);
		# mempool.space-style paths (/api/tx/..., /api/address/...) only exist
		# because of this /api/X -> /api/v1/X rewrite (mempool's own frontend
		# nginx does the same mapping).
		location /api/v1/ {
			set $upstream_api heartwood-v2_mempool-api_1:8999;
			proxy_pass http://$upstream_api$request_uri;
		}

		location /api/ {
			set $upstream_api heartwood-v2_mempool-api_1:8999;
			rewrite ^/api/(.*)$ /api/v1/$1 break;
			proxy_pass http://$upstream_api$uri$is_args$args;
		}

		# --- Wallet app (default / catch-all) ----------------------------------
		# Everything not matched above goes to the wallet, including its
		# SvelteKit asset routes. New wallet routes need zero gateway changes.
		location / {
			set $upstream_wallet heartwood-v2_wallet_1:3000;
			proxy_pass http://$upstream_wallet$request_uri;
		}
	}
}
EOF
